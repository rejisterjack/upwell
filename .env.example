# Copy this file to `.env` and replace the placeholders.

# Pooled Neon connection string. The running app uses this URL.
DATABASE_URL="postgresql://user:password@localhost:5432/upwell"

# Direct, non-pooler Neon connection string. Migrations use this when it is set.
DIRECT_DATABASE_URL="postgresql://user:password@localhost:5432/upwell"

# At least 16 random characters. Vercel sends it as a Bearer token to the cron route.
CRON_SECRET="replace-with-a-long-random-string"

# At least 16 random characters. This is the only admin password.
ADMIN_PASSWORD="replace-with-a-long-random-string"

# Optional email alerts via Resend. Webhooks work without these.
RESEND_API_KEY=""
ALERT_EMAIL_FROM="status@example.com"

# Optional HMAC secret for webhook bodies. Sent as X-Upwell-Signature.
WEBHOOK_SECRET=""

# Initial public name. Change it later in the admin.
SITE_NAME="Status"
